# Internship Logbook — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Storage provider: "local" or "google_drive"
STORAGE_PROVIDER=local

# Google Drive root folder ID (only needed when STORAGE_PROVIDER=google_drive)
# Get this from the Google Drive URL when you open your folder in a browser:
# https://drive.google.com/drive/folders/YOUR_FOLDER_ID_HERE
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Hermes home directory (default: ~/.hermes)
# HERMES_HOME=

# Google OAuth credentials paths (defaults below, usually don't need changing)
# GOOGLE_CLIENT_SECRET_PATH=~/.hermes/google_client_secret.json
# GOOGLE_TOKEN_PATH=~/.hermes/google_token.json
